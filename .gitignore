# ============================================================
# FlowPay .gitignore
# 只提交源码、配置模板与文档；排除密钥、本地配置、数据快照与构建产物
# ============================================================

# ---------- 密钥与本地环境配置（高风险，禁止提交） ----------
.env
.env.*
!.env.example
*.key
*.pem
*.p12
*.pfx
secrets/
.secrets/

# 本地运行配置（保留模板，排除本机实际配置）
backend/configs/local.toml
!backend/configs/local.toml.example
configs/*.local.toml
!configs/*.local.toml.example

# ---------- 数据工程与本地快照 ----------
# 保留 flowpay-dataset 的源码、文档、知识库与基准设计
# 仅排除本机运行生成的大体积业务快照（约 150MB+）
flowpay-dataset/data/generated/
flowpay-dataset*.tar.gz
flowpay-dataset*.zip
flowpay-dataset

# 本地数据库与临时数据文件
*.sqlite
*.sqlite3
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm
*.db
*.db-wal
*.db-shm
*.dump
*.duckdb
*.parquet
data/
var/

# ---------- Python ----------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
env/
ENV/
.eggs/
*.egg-info/
build/
dist/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.pyright_cache/
.tox/
.nox/
.ipynb_checkpoints/
.coverage
.coverage.*
htmlcov/
coverage.xml

# ---------- Node / 前端 ----------
node_modules/
.vite/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
frontend/dist/
dist-ssr/
.eslintcache

# ---------- 日志、缓存与临时文件 ----------
*.log
logs/
tmp/
temp/
.cache/
*.tmp
*.temp
*.bak
*.old
*.orig
*.rej

# ---------- IDE / 操作系统 / AI 工具 ----------
.idea/
.vscode/
.cursor/
.windsurf/
.claude/settings.local.json
*.swp
*.swo
*~
.DS_Store
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
desktop.ini