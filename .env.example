# 聊天模型密钥
FLOWPAY_MODEL_API_KEY=''
# 换模型改这两项，留空则用 backend/configs/local.toml 里的默认值
# 任何 OpenAI 兼容的服务都可以，例如：
#   FLOWPAY_MODEL_BASE_URL='https://api.openai.com/v1'      FLOWPAY_MODEL_NAME='gpt-4.1-mini'
#   FLOWPAY_MODEL_BASE_URL='https://openrouter.ai/api/v1'   FLOWPAY_MODEL_NAME='anthropic/claude-sonnet-4'
#   FLOWPAY_MODEL_BASE_URL='http://127.0.0.1:11434/v1'      FLOWPAY_MODEL_NAME='qwen3:8b'
FLOWPAY_MODEL_BASE_URL=''
FLOWPAY_MODEL_NAME=''

# 数据包路径
#   ../flowpay-dataset-v1
FLOWPAY_DATASET_ROOT=''


# 嵌入模型使用本地服务
OLLAMA_API_KEY=ollama
# 嵌入服务由 make up 起（容器内 Ollama + qwen3-embedding:0.6b）。
# 只有要指向别处的 Ollama 时才填，而且端口必须是 11434：
# 知识集合的向量是基于该端口创建，换端口会被向量空间校验判为不兼容。
# FLOWPAY_EMBEDDING_BASE_URL='http://host.docker.internal:11434/v1'